[[ -o interactive ]] || return

# ── Options ───────────────────────────────────────────────────────────────────
setopt NO_BEEP NO_LIST_BEEP INTERACTIVE_COMMENTS NO_FLOW_CONTROL
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt EXTENDED_GLOB COMPLETE_IN_WORD ALWAYS_TO_END
setopt AUTO_PARAM_SLASH AUTO_MENU LIST_PACKED LIST_TYPES
setopt PROMPT_SUBST

setopt EXTENDED_HISTORY SHARE_HISTORY INC_APPEND_HISTORY_TIME
setopt HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_ALL_DUPS HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_VERIFY
setopt HIST_FIND_NO_DUPS HIST_SAVE_NO_DUPS

HISTFILE=$HOME/.zsh_history
HISTSIZE=5000000
SAVEHIST=5000000

# ── Environment ───────────────────────────────────────────────────────────────
export EDITOR=vim
export VISUAL=$EDITOR
export PAGER=less
export LESS=-RFi
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

[[ -n $SSH_CONNECTION || -n $SSH_TTY ]] && export IS_SSH=1 || export IS_SSH=0

# ── PATH ──────────────────────────────────────────────────────────────────────
typeset -U path
path=(
  $HOME/.cargo/bin
  $HOME/.local/bin
  $HOME/bin
  /opt/homebrew/bin(N)
  $HOME/.pyenv/bin(N)
  $HOME/.rbenv/bin(N)
  $HOME/.juliaup/bin(N)
  /usr/local/bin
  /usr/bin
  /bin
)
command -v pyenv >/dev/null && eval "$(pyenv init - --no-rehash)"
command -v rbenv >/dev/null && eval "$(rbenv init - --no-rehash)"

# ── Aliases ───────────────────────────────────────────────────────────────────
if command -v eza >/dev/null; then
  alias ls='eza --icons=auto --group-directories-first'
  alias l='eza -a --icons=auto --group-directories-first'
  alias ll='eza -la --icons=auto --git --group-directories-first'
  alias lt='eza --tree --icons=auto --level=2'
  alias la='eza -la --icons=auto --group-directories-first'
else
  alias ls='ls --color=auto' l='ls -a' ll='ls -la' la='ls -la'
fi
command -v bat >/dev/null && alias cat='bat --style=plain --paging=never'
command -v rg >/dev/null && alias grep=rg

alias g=git t=tig ta='tig --all' vi=vim md='mkdir -p' rm='rm -i'
alias ..='cd ..' ...='cd ../..' ....='cd ../../..'
alias -- -='cd -' d='dirs -v'

# ── Plugins ───────────────────────────────────────────────────────────────────
source $HOME/.zsh/plugin.zsh

plugin --binary x-motemen/ghq '*/ghq'
plugin --binary junegunn/fzf
plugin --binary ajeetdsouza/zoxide

plugin --fpath zsh-users/zsh-completions src
plugin zdharma-continuum/fast-syntax-highlighting
plugin zsh-users/zsh-autosuggestions
plugin zsh-users/zsh-history-substring-search

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ── Completion ────────────────────────────────────────────────────────────────
ZSH_CACHE_DIR=$HOME/.zsh/cache
mkdir -p $ZSH_CACHE_DIR

autoload -Uz compinit
if [[ ! -f $ZSH_CACHE_DIR/zcompdump || -n $ZSH_CACHE_DIR/zcompdump(#qN.mh+24) ]]; then
  compinit -d $ZSH_CACHE_DIR/zcompdump
else
  compinit -C -d $ZSH_CACHE_DIR/zcompdump
fi

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path $ZSH_CACHE_DIR
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' group-name ''
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '%F{yellow}── %d ──%f'

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#565f89'

# ── Prompt ────────────────────────────────────────────────────────────────────
# Local: starship. Remote (SSH): lightweight. Switch anytime with: prompt_theme
autoload -Uz add-zsh-hook colors
colors

_git_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null
}

_short_pwd() {
  local p=${(%):-%~}
  [[ $p == / || $p == ~ || $p != */* ]] && { print -r -- $p; return }
  print -r -- ${${p%/*}:gs|/([^/])[^/]##|/\1|}/${p##*/}
}

_prompt_git() {
  local b=$(_git_branch) || return
  print -rn -- " %F{#bb9af7}${b}%f"
}

_prompt_ssh() {
  (( IS_SSH )) || return
  print -rn -- "%F{#e0af68}@%m%f "
}

prompt_theme_light() {
  add-zsh-hook -d precmd prompt_starship_precmd 2>/dev/null
  add-zsh-hook -d preexec prompt_starship_preexec 2>/dev/null
  unset STARSHIP_SHELL STARSHIP_SESSION_KEY
  unsetopt TRANSIENT_RPROMPT 2>/dev/null
  RPROMPT=
  PROMPT2='%F{#565f89}%_❯%f '
  # @host ~/s/dir [branch] ❯
  PROMPT='$(_prompt_ssh)%F{#7aa2f7}$(_short_pwd)%f$(_prompt_git) %(?.%F{#9ece6a}.%F{#f7768e})❯%f '
  typeset -g PROMPT_THEME=light
}

prompt_theme_starship() {
  if ! command -v starship >/dev/null; then
    print -u2 'prompt_theme: starship not found; using light'
    prompt_theme_light
    return 1
  fi
  eval "$(starship init zsh)"
  typeset -g PROMPT_THEME=starship
}

# prompt_theme [auto|light|starship]
#   auto     — light over SSH, starship locally (default)
#   light    — minimal prompt (good for remote / slow links)
#   starship — full starship prompt
prompt_theme() {
  case ${1:-auto} in
    auto)
      if (( IS_SSH )); then
        prompt_theme_light
      elif command -v starship >/dev/null; then
        prompt_theme_starship
      else
        prompt_theme_light
      fi
      ;;
    light|lite|minimal) prompt_theme_light ;;
    starship|full)      prompt_theme_starship ;;
    *)
      print -u2 "usage: prompt_theme [auto|light|starship]  (current: ${PROMPT_THEME:-unset})"
      return 1
      ;;
  esac
}

prompt_theme auto

# ── Keybindings ───────────────────────────────────────────────────────────────
# bindkey -e must run before autopair-init, or it clears the pair bindings
bindkey -e
bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^ ' autosuggest-accept

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

zmodload zsh/complist 2>/dev/null
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Autopair after bindkey -e so pair widgets stay bound
plugin hlissner/zsh-autopair
# Ensure "" autopairs (and rebind in case it was unset)
AUTOPAIR_PAIRS+=('"' '"')
bindkey '"' autopair-insert
bindkey -M isearch '"' self-insert

# fzf: Ctrl-R / Ctrl-T / Alt-C
[[ -f $HOME/.zsh/plugins/fzf/shell/key-bindings.zsh ]] &&
  source $HOME/.zsh/plugins/fzf/shell/key-bindings.zsh

# ghq + z fuzzy (Tab / Ctrl-G)
[[ -f ${DOT_ZSH_ROOT:-$HOME/.zsh}/fzf-extensions/init.zsh ]] &&
  source ${DOT_ZSH_ROOT:-$HOME/.zsh}/fzf-extensions/init.zsh

command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v opam >/dev/null && eval "$(opam env 2>/dev/null)"

[[ -f $HOME/.zshrc.local ]] && source $HOME/.zshrc.local
