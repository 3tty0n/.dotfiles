#!/usr/bin/env sh
#
# yabai v7 — layouts via ylayout: bsp | center

# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa

export PATH="/opt/homebrew/bin:$PATH"
YLAYOUT="$HOME/.config/yabai/bin/ylayout"

yabai -m config mouse_follows_focus          on
yabai -m config focus_follows_mouse          autoraise
yabai -m config window_placement             second_child
yabai -m config window_insertion_point       first
yabai -m config window_opacity               on
yabai -m config window_opacity_duration      0.15
yabai -m config active_window_opacity        1.0
yabai -m config normal_window_opacity        0.90
yabai -m config window_shadow                float
yabai -m config insert_feedback_color        0xffd75f5f
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

yabai -m config layout                       bsp
yabai -m config top_padding                  12
yabai -m config bottom_padding               12
yabai -m config left_padding                 12
yabai -m config right_padding                12
yabai -m config window_gap                   12

yabai -m rule --add app='^System Settings$' manage=off
yabai -m rule --add app='^System Preferences$' manage=off
yabai -m rule --add app='^Inkscape$' manage=off

# Emacs (emacs-mac): closing the last frame and reopening often leaves the
# new NSWindow unmanaged (wrong AX role, or floating). Force-manage real
# frames; unfloat on create/show. Empty title = child frames (posframe).
yabai -m rule --add app='^Emacs$' title!='^$' manage=on
yabai -m rule --add app='^Emacs$' role='AXTextField' subrole='AXStandardWindow' manage=on
yabai -m signal --add app='^Emacs$' event=window_created action="$YLAYOUT emacs-frame \$YABAI_WINDOW_ID"
yabai -m signal --add app='^Emacs$' event=application_visible action="$YLAYOUT emacs-frame"
yabai -m signal --add app='^Emacs$' event=application_launched action="$YLAYOUT emacs-frame"

# CenterMaster maintenance (no-op while in bsp; debounced + fingerprint for tabs)
yabai -m signal --add event=window_created action="$YLAYOUT event"
yabai -m signal --add event=window_destroyed action="$YLAYOUT event"
yabai -m signal --add event=window_minimized action="$YLAYOUT event"
yabai -m signal --add event=window_deminimized action="$YLAYOUT event"
yabai -m signal --add event=application_launched action="$YLAYOUT event"
yabai -m signal --add event=application_hidden action="$YLAYOUT event"
yabai -m signal --add event=application_visible action="$YLAYOUT event"

# Ghostty native tabs = extra NSWindows. Keep them managed. In bsp mode the
# signal below re-applies the layout after tab churn; center mode restamps the
# shared Ghostty slot without switching the whole space back to bsp.
yabai -m rule --add app='^[Gg]hostty$' manage=on
yabai -m rule --apply app='^[Gg]hostty$' manage=on
yabai -m signal --add app='^[Gg]hostty$' event=window_created action="$YLAYOUT ghostty-tab \$YABAI_WINDOW_ID"
yabai -m signal --add app='^[Gg]hostty$' event=window_destroyed action="$YLAYOUT ghostty-tab \$YABAI_WINDOW_ID"

"$YLAYOUT" apply

echo "yabai configuration loaded.."
