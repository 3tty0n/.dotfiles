#!/usr/bin/env bash
# Layout dispatcher: bsp | center (CenterMaster)
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"

YABAI="${YABAI:-/opt/homebrew/bin/yabai}"
BIN="$(cd "$(dirname "$0")" && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yabai"
LAYOUTS="$STATE_DIR/layouts.json"
RATIOS="$STATE_DIR/ratios.json"
MASTER_FILE="$STATE_DIR/center-master-id"
APPLY_LOCK="$STATE_DIR/apply.lock"
DEFAULT_RATIO="${YLAYOUT_MASTER_RATIO:-0.50}"
RATIO_STEP="${YLAYOUT_RATIO_STEP:-0.05}"

mkdir -p "$STATE_DIR"
[[ -f "$LAYOUTS" ]] || echo '{}' >"$LAYOUTS"
[[ -f "$RATIOS" ]] || echo '{}' >"$RATIOS"

space_id() {
  "$YABAI" -m query --spaces --space | jq -r '.index'
}

# Normalize legacy "master" (ymsp) → bsp
get_mode() {
  local sid="${1:-$(space_id)}"
  local mode
  mode="$(jq -r --arg s "$sid" '.[$s] // "bsp"' "$LAYOUTS")"
  case "$mode" in
    center) echo center ;;
    *) echo bsp ;;
  esac
}

set_mode() {
  local mode="$1"
  case "$mode" in
    center) ;;
    master|bsp) mode=bsp ;;
    *) mode=bsp ;;
  esac
  local sid tmp
  sid="$(space_id)"
  tmp="$(mktemp)"
  jq --arg s "$sid" --arg m "$mode" '.[$s]=$m' "$LAYOUTS" >"$tmp"
  mv "$tmp" "$LAYOUTS"
}

with_apply_lock() {
  if [[ -f "$APPLY_LOCK" ]]; then
    local pid
    pid="$(cat "$APPLY_LOCK" 2>/dev/null || true)"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$APPLY_LOCK"
  fi
  echo $$ >"$APPLY_LOCK"
  "$@"
  local st=$?
  rm -f "$APPLY_LOCK"
  return "$st"
}

apply_center() {
  with_apply_lock _apply_center
}

_apply_center() {
  # Large master sits under the cursor; autoraise would immediately steal
  # keyboard focus back (especially to Safari).
  "$YABAI" -m config focus_follows_mouse off
  "$YABAI" -m space --layout float
  "$BIN/center-master"
  layout_fingerprint >"$STATE_DIR/layout-fp"
}

apply_bsp() {
  with_apply_lock _apply_bsp
}

_apply_bsp() {
  "$YABAI" -m config focus_follows_mouse autoraise
  "$YABAI" -m space --layout bsp
  ghostty_unfloat
}

apply_current() {
  case "$(get_mode)" in
    center) apply_center ;;
    *) apply_bsp ;;
  esac
}

promote() {
  case "$(get_mode)" in
    center)
      "$YABAI" -m query --windows --window | jq -r '.id' >"$MASTER_FILE"
      apply_center
      ;;
    *)
      "$YABAI" -m window --swap first
      ;;
  esac
}

# AX windows on the focused space (float/center has no BSP tree).
ax_windows_json() {
  "$YABAI" -m query --windows --space | jq '[.[] | select(
    ."has-ax-reference" == true and
    ."is-minimized" == false and
    ."is-hidden" == false
  )]'
}

# sort_key: yx (focus up/down) | xy (focus left/right)
ordered_ids() {
  local sort_key="${1:-yx}"
  case "$sort_key" in
    xy) ax_windows_json | jq -r 'sort_by(.frame.x, .frame.y) | .[].id' ;;
    *)  ax_windows_json | jq -r 'sort_by(.frame.y, .frame.x) | .[].id' ;;
  esac
}

focus_offset() {
  local offset="$1"
  local sort_key="${2:-yx}"
  local ids n cur idx target
  ids="$(ordered_ids "$sort_key")"
  n="$(grep -c . <<<"$ids" || true)"
  [[ "$n" -le 1 ]] && return 0
  cur="$("$YABAI" -m query --windows --window | jq -r '.id')"
  idx="$(grep -n "^${cur}$" <<<"$ids" | head -1 | cut -d: -f1)"
  idx="${idx:-1}"
  idx=$(( (idx - 1 + offset) % n ))
  [[ "$idx" -lt 0 ]] && idx=$((idx + n))
  target="$(sed -n "$((idx + 1))p" <<<"$ids")"
  "$YABAI" -m window --focus "$target"
}

swap_frames() {
  local a="$1" b="$2"
  local ja jb ax ay aw ah bx by bw bh
  ja="$("$YABAI" -m query --windows --window "$a")"
  jb="$("$YABAI" -m query --windows --window "$b")"
  read -r ax ay aw ah <<<"$(jq -r '.frame | "\(.x) \(.y) \(.w) \(.h)"' <<<"$ja")"
  read -r bx by bw bh <<<"$(jq -r '.frame | "\(.x) \(.y) \(.w) \(.h)"' <<<"$jb")"
  "$YABAI" -m window "$a" --move "abs:${bx}:${by}"
  "$YABAI" -m window "$a" --resize "abs:${bw}:${bh}"
  "$YABAI" -m window "$b" --move "abs:${ax}:${ay}"
  "$YABAI" -m window "$b" --resize "abs:${aw}:${ah}"
}

# Swap focused window with neighbor by exchanging absolute frames.
swap_offset() {
  local offset="$1"
  local sort_key="${2:-yx}"
  local ids n cur idx other master
  ids="$(ordered_ids "$sort_key")"
  n="$(grep -c . <<<"$ids" || true)"
  [[ "$n" -le 1 ]] && return 0
  cur="$("$YABAI" -m query --windows --window | jq -r '.id')"
  idx="$(grep -n "^${cur}$" <<<"$ids" | head -1 | cut -d: -f1)"
  idx="${idx:-1}"
  idx=$(( (idx - 1 + offset) % n ))
  [[ "$idx" -lt 0 ]] && idx=$((idx + n))
  other="$(sed -n "$((idx + 1))p" <<<"$ids")"

  master="$(cat "$MASTER_FILE" 2>/dev/null || true)"
  if [[ "$master" == "$cur" ]]; then
    printf '%s' "$other" >"$MASTER_FILE"
  elif [[ "$master" == "$other" ]]; then
    printf '%s' "$cur" >"$MASTER_FILE"
  fi
  swap_frames "$cur" "$other"
  "$YABAI" -m window --focus "$cur"
}

focus_down() {
  case "$(get_mode)" in
    center) focus_offset 1 yx ;;
    *) "$YABAI" -m window --focus south || "$YABAI" -m window --focus next || "$YABAI" -m window --focus first ;;
  esac
}

focus_up() {
  case "$(get_mode)" in
    center) focus_offset -1 yx ;;
    *) "$YABAI" -m window --focus north || "$YABAI" -m window --focus prev || "$YABAI" -m window --focus last ;;
  esac
}

focus_west() {
  case "$(get_mode)" in
    center) focus_offset -1 xy ;;
    *) "$YABAI" -m window --focus west ;;
  esac
}

focus_east() {
  case "$(get_mode)" in
    center) focus_offset 1 xy ;;
    *) "$YABAI" -m window --focus east ;;
  esac
}

focus_south() {
  case "$(get_mode)" in
    center) focus_offset 1 yx ;;
    *) "$YABAI" -m window --focus south ;;
  esac
}

focus_north() {
  case "$(get_mode)" in
    center) focus_offset -1 yx ;;
    *) "$YABAI" -m window --focus north ;;
  esac
}

swap_down() {
  case "$(get_mode)" in
    center) swap_offset 1 yx ;;
    *) "$YABAI" -m window --swap south || "$YABAI" -m window --swap next || "$YABAI" -m window --swap first ;;
  esac
}

swap_up() {
  case "$(get_mode)" in
    center) swap_offset -1 yx ;;
    *) "$YABAI" -m window --swap north || "$YABAI" -m window --swap prev || "$YABAI" -m window --swap last ;;
  esac
}

swap_west() {
  case "$(get_mode)" in
    center) swap_offset -1 xy ;;
    *) "$YABAI" -m window --swap west ;;
  esac
}

swap_east() {
  case "$(get_mode)" in
    center) swap_offset 1 xy ;;
    *) "$YABAI" -m window --swap east ;;
  esac
}

on_event() {
  case "$(get_mode)" in
    center) schedule_center_apply ;;
    *) ;;
  esac
}

# Non-Ghostty tile ids + Ghostty presence (tabs share one slot; never a count).
# Ghostty AX/visibility flaps on native-tab churn and right after yabai restart,
# so "g" is advisory: we retile on 0→1, never on 1→0 alone.
layout_fingerprint() {
  "$YABAI" -m query --windows --space | jq -c '
    [.[] | select(
      ."is-minimized" == false and
      ."is-hidden" == false
    )]
    | {
        o: [.[]
          | select(
              (.app | test("ghostty"; "i") | not) and
              ."has-ax-reference" == true and
              ."is-visible" == true
            )
          | .id
        ] | sort,
        g: (if any(.app | test("ghostty"; "i")) then 1 else 0 end)
      }
  '
}

fp_field() {
  jq -r --arg k "$2" '.[$k] | if type == "array" then tostring else . end' <<<"$1"
}

schedule_center_apply() {
  local token fp now old now_o old_o now_g old_g
  token="$$.$RANDOM"
  echo "$token" >"$STATE_DIR/event.token"
  # Wait out native-tab destroy/create where Ghostty briefly loses AX/visibility.
  sleep 0.2
  [[ "$(cat "$STATE_DIR/event.token" 2>/dev/null || true)" == "$token" ]] || return 0

  fp="$STATE_DIR/layout-fp"
  now="$(layout_fingerprint)"
  old="$(cat "$fp" 2>/dev/null || true)"
  [[ -n "$old" ]] || old='{"o":[],"g":-1}'
  now_o="$(fp_field "$now" o)"
  now_g="$(fp_field "$now" g)"
  old_o="$(fp_field "$old" o)"
  old_g="$(fp_field "$old" g)"

  if [[ "$now_o" == "$old_o" && "$now_g" == "$old_g" ]]; then
    return 0
  fi

  # Non-Ghostty tiles unchanged: only Ghostty presence flipped.
  if [[ "$now_o" == "$old_o" ]]; then
    # 1→0 is almost always tab churn / AX flap (esp. after restart).
    # Retiling here drops Ghostty from CenterMaster and leaves it floating.
    if [[ "$now_g" == "0" ]]; then
      return 0
    fi
    # 0→1: Ghostty (re)appeared — give it a slot.
    apply_center
    return 0
  fi

  apply_center
}

# Ghostty native tabs (= extra NSWindows). yabai often keeps a zombie CG id
# (has-ax-reference=false) while System Events still sees the real AXWindow.
GHOSTTY_FRAME="$STATE_DIR/ghostty-frame"

ghostty_standard_ax_ids() {
  "$YABAI" -m query --windows --space 2>/dev/null | jq -r '
    .[] | select(
      (.app | test("ghostty"; "i")) and
      ."has-ax-reference" == true and
      .role == "AXWindow" and
      (.subrole == "AXStandardWindow" or .subrole == "")
    ) | .id
  ' 2>/dev/null || true
}

ghostty_unfloat() {
  local wids wid
  wids="$("$YABAI" -m query --windows --space 2>/dev/null | jq -r '
    .[] | select(
      (.app | test("ghostty"; "i")) and
      ."has-ax-reference" == true and
      .role == "AXWindow" and
      (.subrole == "AXStandardWindow" or .subrole == "") and
      ."is-floating" == true
    ) | .id
  ' 2>/dev/null || true)"
  [[ -z "$wids" ]] && return 0
  while read -r wid; do
    [[ -z "$wid" ]] && continue
    "$YABAI" -m window --toggle float "$wid" 2>/dev/null || true
  done <<<"$wids"
}

ghostty_unfloat_id() {
  local wid="$1" json
  [[ -z "$wid" ]] && return 0
  json="$("$YABAI" -m query --windows --window "$wid" 2>/dev/null || true)"
  [[ -z "$json" ]] && return 0
  jq -e '
    (.app | test("ghostty"; "i")) and
    ."has-ax-reference" == true and
    .role == "AXWindow" and
    (.subrole == "AXStandardWindow" or .subrole == "") and
    ."is-floating" == true
  ' <<<"$json" >/dev/null 2>&1 || return 0
  "$YABAI" -m window --toggle float "$wid" 2>/dev/null || true
}

# Stamp Ghostty into the CenterMaster slot. yabai first; System Events if AX is lost.
ghostty_ax_place() {
  local x y w h ids id placed
  [[ -f "$GHOSTTY_FRAME" ]] || return 0
  read -r x y w h <"$GHOSTTY_FRAME" || return 0
  [[ -n "${x:-}" && -n "${y:-}" && -n "${w:-}" && -n "${h:-}" ]] || return 0
  placed=0
  ids="$(ghostty_standard_ax_ids)"
  if [[ -n "$ids" ]]; then
    while read -r id; do
      [[ -z "$id" ]] && continue
      if "$YABAI" -m window "$id" --move "abs:${x}:${y}" 2>/dev/null; then
        "$YABAI" -m window "$id" --resize "abs:${w}:${h}" 2>/dev/null || true
        placed=1
      fi
    done <<<"$ids"
  fi
  [[ "$placed" -eq 1 ]] && return 0
  osascript - "$x" "$y" "$w" "$h" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  set x to (item 1 of argv) as integer
  set y to (item 2 of argv) as integer
  set w to (item 3 of argv) as integer
  set h to (item 4 of argv) as integer
  tell application "System Events"
    if not (exists process "Ghostty") then return
    tell process "Ghostty"
      repeat with win in (get windows)
        try
          if (role of win is "AXWindow") and (subrole of win is "AXStandardWindow") then
            set p to position of win
            set s to size of win
            set px to item 1 of p as integer
            set py to item 2 of p as integer
            set sw to item 1 of s as integer
            set sh to item 2 of s as integer
            -- 32px: menu bar clamps yabai's y=PAD to ~30; tighter would restamp every event (blink).
            if (px > x + 32) or (px < x - 32) or (py > y + 32) or (py < y - 32) or (sw > w + 32) or (sw < w - 32) or (sh > h + 32) or (sh < h - 32) then
              set position of win to {x, y}
              set size of win to {w, h}
            end if
          end if
        end try
      end repeat
    end tell
  end tell
end run
APPLESCRIPT
}

ghostty_tab() {
  local wid="${1:-}" token
  ghostty_unfloat_id "$wid"
  token="$$.$RANDOM"
  echo "$token" >"$STATE_DIR/ghostty.token"
  sleep 0.2
  [[ "$(cat "$STATE_DIR/ghostty.token" 2>/dev/null || true)" == "$token" ]] || return 0
  case "$(get_mode)" in
    center) ghostty_ax_place ;;
    *) ghostty_unfloat ;;
  esac
}

cycle() {
  local next
  case "$(get_mode)" in
    center) next=bsp ;;
    *) next=center ;;
  esac
  set_mode "$next"
  apply_current
  echo "$next"
}

get_ratio() {
  local sid="${1:-$(space_id)}"
  jq -r --arg s "$sid" --arg d "$DEFAULT_RATIO" '.[$s] // $d' "$RATIOS"
}

set_ratio() {
  local ratio="$1" sid tmp
  sid="$(space_id)"
  tmp="$(mktemp)"
  jq --arg s "$sid" --argjson r "$ratio" '.[$s]=$r' "$RATIOS" >"$tmp"
  mv "$tmp" "$RATIOS"
}

# XMonad-style: Mod-h/l adjust master pane width (center) or yabai split (bsp).
resize_horizontal() {
  local dir="$1" # shrink|grow
  case "$(get_mode)" in
    center)
      local delta r
      case "$dir" in
        shrink) delta="-$RATIO_STEP" ;;
        *) delta="$RATIO_STEP" ;;
      esac
      r="$(python3 -c "print(round(max(0.25, min(0.70, float('$(get_ratio)') + float('$delta'))), 3))")"
      set_ratio "$r"
      apply_center
      ;;
    *)
      case "$dir" in
        shrink) "$YABAI" -m window --resize left:-60:0 || "$YABAI" -m window --resize right:-60:0 ;;
        *) "$YABAI" -m window --resize left:60:0 || "$YABAI" -m window --resize right:60:0 ;;
      esac
      ;;
  esac
}

resize_vertical() {
  local dir="$1" # shrink|grow
  case "$(get_mode)" in
    center)
      # Stack rows stay equal in CenterMaster; no per-window ratio yet.
      return 0
      ;;
    *)
      case "$dir" in
        shrink) "$YABAI" -m window --resize top:0:-60 || "$YABAI" -m window --resize bottom:0:-60 ;;
        *) "$YABAI" -m window --resize top:0:60 || "$YABAI" -m window --resize bottom:0:60 ;;
      esac
      ;;
  esac
}

balance() {
  case "$(get_mode)" in
    center)
      set_ratio "$DEFAULT_RATIO"
      apply_center
      ;;
    *) "$YABAI" -m space --balance ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  get) get_mode ;;
  set)
    set_mode "${2:?mode required: bsp|center}"
    apply_current
    ;;
  cycle) cycle ;;
  apply) apply_current ;;
  event) on_event ;;
  promote) promote ;;
  focus-down) focus_down ;;
  focus-up) focus_up ;;
  focus-west) focus_west ;;
  focus-east) focus_east ;;
  focus-south) focus_south ;;
  focus-north) focus_north ;;
  swap-down) swap_down ;;
  swap-up) swap_up ;;
  swap-west) swap_west ;;
  swap-east) swap_east ;;
  shrink) resize_horizontal shrink ;;
  grow) resize_horizontal grow ;;
  shrink-v) resize_vertical shrink ;;
  grow-v) resize_vertical grow ;;
  balance) balance ;;
  ratio) get_ratio ;;
  ghostty-tab|ghostty-bsp) ghostty_tab "${2:-}" ;;
  ghostty-ax-place) ghostty_ax_place ;;
  *)
    echo "usage: ylayout get|set <bsp|center>|cycle|apply|event|promote|focus-*|swap-*|shrink|grow|shrink-v|grow-v|balance|ratio|ghostty-tab" >&2
    exit 1
    ;;
esac
