#!/usr/bin/env bash
# CenterMaster for yabai: | left stack | MASTER | right stack |
# Requires the space layout to be float (absolute frames).
#
# Ghostty native tabs are extra NSWindows — collapse them to one tile and
# stamp the same frame onto every Ghostty window.
set -euo pipefail

YABAI="${YABAI:-/opt/homebrew/bin/yabai}"
BIN="$(cd "$(dirname "$0")" && pwd)"
PAD="${YLAYOUT_PAD:-8}"
GAP="${YLAYOUT_GAP:-8}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yabai"
MASTER_FILE="$STATE_DIR/center-master-id"
RATIOS="$STATE_DIR/ratios.json"
DEFAULT_RATIO="${YLAYOUT_MASTER_RATIO:-0.50}"

mkdir -p "$STATE_DIR"
[[ -f "$RATIOS" ]] || echo '{}' >"$RATIOS"

space="$("$YABAI" -m query --spaces --space)"
sid="$(jq -r '.index' <<<"$space")"
did="$(jq -r '.display' <<<"$space")"
disp="$("$YABAI" -m query --displays --display "$did")"

RATIO="$(jq -r --arg s "$sid" --arg d "$DEFAULT_RATIO" '.[$s] // $d' "$RATIOS")"

read -r DX DY DW DH <<<"$(jq -r '.frame | "\(.x|floor) \(.y|floor) \(.w|floor) \(.h|floor)"' <<<"$disp")"

ox=$((DX + PAD))
oy=$((DY + PAD))
uw=$((DW - 2 * PAD))
uh=$((DH - 2 * PAD))

all="$("$YABAI" -m query --windows --space "$sid")"

# Non-Ghostty: strict (AX + visible). Ghostty: keep all non-minimized windows;
# tabs flap AX/visibility and must still share one slot.
others="$(jq '[.[] | select(
  (.app | test("ghostty"; "i") | not) and
  ."has-ax-reference" == true and
  ."is-minimized" == false and
  ."is-hidden" == false and
  ."is-visible" == true
)]' <<<"$all")"

# Prefer real AX standard windows. Zombies (ax=false after tab close) and
# AXSheet confirm dialogs must not steal a CenterMaster slot.
ghostties="$(jq '[.[] | select(
  (.app | test("ghostty"; "i")) and
  ."is-minimized" == false and
  ."is-hidden" == false and
  .role != "AXSheet" and
  (
    (."has-ax-reference" == true and .role == "AXWindow") or
    (."has-ax-reference" == false)
  )
)]' <<<"$all")"

# Drop zombies when at least one AX Ghostty exists.
if jq -e 'any(."has-ax-reference" == true)' <<<"$ghostties" >/dev/null 2>&1; then
  ghostties="$(jq '[.[] | select(."has-ax-reference" == true)]' <<<"$ghostties")"
fi

# Prefer focused Ghostty, else one with AX, else first.
ghost_rep="$(jq -c '
  (map(select(."has-focus" == true))[0])
  // (map(select(."has-ax-reference" == true))[0])
  // .[0]
  // empty
' <<<"$ghostties")"

if [[ -n "$ghost_rep" && "$ghost_rep" != "null" ]]; then
  wins="$(jq -c --argjson g "$ghost_rep" '. + [$g]' <<<"$others")"
else
  wins="$others"
fi

n="$(jq 'length' <<<"$wins")"
[[ "$n" -eq 0 ]] && exit 0

master_id="$(cat "$MASTER_FILE" 2>/dev/null || true)"
if [[ -z "$master_id" ]] || ! jq -e --argjson id "$master_id" 'map(.id) | index($id) != null' <<<"$wins" >/dev/null 2>&1; then
  master_id="$(jq -r '.[0].id' <<<"$wins")"
fi
printf '%s' "$master_id" >"$MASTER_FILE"

ordered="$(jq --argjson m "$master_id" '
  (map(select(.id == $m))[0]) as $master
  | [$master] + [(.[] | select(.id != $m))]
' <<<"$wins")"

place() {
  local id="$1" x="$2" y="$3" w="$4" h="$5"
  "$YABAI" -m window "$id" --move "abs:${x}:${y}" 2>/dev/null || true
  "$YABAI" -m window "$id" --resize "abs:${w}:${h}" 2>/dev/null || true
}

# After placing the Ghostty representative, stamp the slot (yabai, else System Events).
place_ghostty_slot() {
  local x="$1" y="$2" w="$3" h="$4"
  printf '%s %s %s %s\n' "$x" "$y" "$w" "$h" >"$STATE_DIR/ghostty-frame"
  "$BIN/ylayout" ghostty-ax-place
}

is_ghostty_id() {
  jq -e --argjson id "$1" 'map(.id) | index($id) != null' <<<"$ghostties" >/dev/null 2>&1
}

mid="$(jq -r '.[0].id' <<<"$ordered")"

if [[ "$n" -eq 1 ]]; then
  if is_ghostty_id "$mid"; then
    place_ghostty_slot "$ox" "$oy" "$uw" "$uh"
  else
    place "$mid" "$ox" "$oy" "$uw" "$uh"
  fi
  exit 0
fi

# Keep side stacks usable; clamp master width between ~25% and ~70% of usable width.
mw="$(python3 -c "print(int($uw * float('$RATIO')))")"
min_side=200
max_m=$((uw - 2 * min_side - 2 * GAP))
[[ "$max_m" -lt $((uw / 4)) ]] && max_m=$((uw / 4))
min_m=$((uw / 4))
[[ "$mw" -gt "$max_m" ]] && mw=$max_m
[[ "$mw" -lt "$min_m" ]] && mw=$min_m

side=$(( (uw - mw - 2 * GAP) / 2 ))
rw=$((uw - mw - 2 * GAP - side))
mx=$((ox + side + GAP))
lx=$ox
rx=$((mx + mw + GAP))

if is_ghostty_id "$mid"; then
  place_ghostty_slot "$mx" "$oy" "$mw" "$uh"
else
  place "$mid" "$mx" "$oy" "$mw" "$uh"
fi

stack="$(jq -c '.[1:]' <<<"$ordered")"
sn="$(jq 'length' <<<"$stack")"
left="$(jq -c 'to_entries | map(select(.key % 2 == 0) | .value)' <<<"$stack")"
right="$(jq -c 'to_entries | map(select(.key % 2 == 1) | .value)' <<<"$stack")"

stack_col() {
  local col_x="$1" col_w="$2" json="$3"
  local count i id yh yy hh
  count="$(jq 'length' <<<"$json")"
  [[ "$count" -eq 0 ]] && return 0
  i=0
  while [[ "$i" -lt "$count" ]]; do
    id="$(jq -r ".[$i].id" <<<"$json")"
    yh=$(( (uh - (count - 1) * GAP) / count ))
    yy=$((oy + i * (yh + GAP)))
    if [[ "$i" -eq $((count - 1)) ]]; then
      hh=$((oy + uh - yy))
    else
      hh=$yh
    fi
    if is_ghostty_id "$id"; then
      place_ghostty_slot "$col_x" "$yy" "$col_w" "$hh"
    else
      place "$id" "$col_x" "$yy" "$col_w" "$hh"
    fi
    i=$((i + 1))
  done
}

if [[ "$sn" -eq 1 ]]; then
  stack_col "$rx" "$rw" "$stack"
else
  stack_col "$lx" "$side" "$left"
  stack_col "$rx" "$rw" "$right"
fi
