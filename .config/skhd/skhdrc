# XMonad-style + CenterMaster
# Mod = alt
# Safari absorbs bare Option+letter as special chars; Karabiner (Safari only)
# rewrites Option → Ctrl+Option, so duplicate ctrl+alt bindings exist below.

# ---- focus ----
alt - j : $HOME/.config/yabai/bin/ylayout focus-down
alt - k : $HOME/.config/yabai/bin/ylayout focus-up
ctrl + alt - j : $HOME/.config/yabai/bin/ylayout focus-down
ctrl + alt - k : $HOME/.config/yabai/bin/ylayout focus-up
ctrl + alt - h : $HOME/.config/yabai/bin/ylayout focus-west
ctrl + alt - l : $HOME/.config/yabai/bin/ylayout focus-east

# ---- swap / promote master (Mod-Return) ----
shift + alt - j : $HOME/.config/yabai/bin/ylayout swap-down
shift + alt - k : $HOME/.config/yabai/bin/ylayout swap-up
shift + alt - h : $HOME/.config/yabai/bin/ylayout swap-west
shift + alt - l : $HOME/.config/yabai/bin/ylayout swap-east
ctrl + shift + alt - j : $HOME/.config/yabai/bin/ylayout swap-down
ctrl + shift + alt - k : $HOME/.config/yabai/bin/ylayout swap-up
ctrl + shift + alt - h : $HOME/.config/yabai/bin/ylayout swap-west
ctrl + shift + alt - l : $HOME/.config/yabai/bin/ylayout swap-east
alt - return             : $HOME/.config/yabai/bin/ylayout promote
ctrl + alt - return      : $HOME/.config/yabai/bin/ylayout promote

# ---- resize (XMonad: Mod-h/l = master ratio in center; bsp split otherwise) ----
alt - h : $HOME/.config/yabai/bin/ylayout shrink
alt - l : $HOME/.config/yabai/bin/ylayout grow
alt - i : $HOME/.config/yabai/bin/ylayout shrink-v
alt - o : $HOME/.config/yabai/bin/ylayout grow-v
ctrl + alt - i : $HOME/.config/yabai/bin/ylayout shrink-v
ctrl + alt - o : $HOME/.config/yabai/bin/ylayout grow-v
shift + alt - 0 : $HOME/.config/yabai/bin/ylayout balance
ctrl + shift + alt - 0 : $HOME/.config/yabai/bin/ylayout balance

# ---- workspaces ----
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
ctrl + alt - 1 : yabai -m space --focus 1
ctrl + alt - 2 : yabai -m space --focus 2
ctrl + alt - 3 : yabai -m space --focus 3
ctrl + alt - 4 : yabai -m space --focus 4
ctrl + alt - 5 : yabai -m space --focus 5
ctrl + alt - 6 : yabai -m space --focus 6
ctrl + alt - 7 : yabai -m space --focus 7
ctrl + alt - 8 : yabai -m space --focus 8
ctrl + alt - 9 : yabai -m space --focus 9

shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + alt - 7 : yabai -m window --space 7; yabai -m space --focus 7
shift + alt - 8 : yabai -m window --space 8; yabai -m space --focus 8
shift + alt - 9 : yabai -m window --space 9; yabai -m space --focus 9
ctrl + shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
ctrl + shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
ctrl + shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
ctrl + shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
ctrl + shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
ctrl + shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
ctrl + shift + alt - 7 : yabai -m window --space 7; yabai -m space --focus 7
ctrl + shift + alt - 8 : yabai -m window --space 8; yabai -m space --focus 8
ctrl + shift + alt - 9 : yabai -m window --space 9; yabai -m space --focus 9

# ---- layouts: bsp ↔ center ----
alt - space         : $HOME/.config/yabai/bin/ylayout cycle
shift + alt - space : $HOME/.config/yabai/bin/ylayout set bsp
alt - m             : $HOME/.config/yabai/bin/ylayout set center
shift + alt - m     : $HOME/.config/yabai/bin/ylayout set bsp
alt - b             : $HOME/.config/yabai/bin/ylayout set bsp
ctrl + alt - space         : $HOME/.config/yabai/bin/ylayout cycle
ctrl + shift + alt - space : $HOME/.config/yabai/bin/ylayout set bsp
ctrl + alt - m             : $HOME/.config/yabai/bin/ylayout set center
ctrl + shift + alt - m     : $HOME/.config/yabai/bin/ylayout set bsp
ctrl + alt - b             : $HOME/.config/yabai/bin/ylayout set bsp

# ---- window ops ----
shift + alt - c : yabai -m window --close
alt - t         : yabai -m window --toggle float
alt - f         : yabai -m window --toggle zoom-fullscreen
shift + alt - f : yabai -m window --toggle native-fullscreen
alt - s         : yabai -m window --toggle sticky
alt - e         : yabai -m display --focus next || yabai -m display --focus first
ctrl + shift + alt - c : yabai -m window --close
ctrl + alt - t         : yabai -m window --toggle float
ctrl + alt - f         : yabai -m window --toggle zoom-fullscreen
ctrl + shift + alt - f : yabai -m window --toggle native-fullscreen
ctrl + alt - s         : yabai -m window --toggle sticky
ctrl + alt - e         : yabai -m display --focus next || yabai -m display --focus first

alt - r : yabai -m space --rotate 90
alt - y : yabai -m space --mirror y-axis
alt - x : yabai -m space --mirror x-axis
ctrl + alt - r : yabai -m space --rotate 90
ctrl + alt - y : yabai -m space --mirror y-axis
ctrl + alt - x : yabai -m space --mirror x-axis

alt - w : yabai -m display --focus prev || yabai -m display --focus last
shift + alt - w : yabai -m window --display prev; yabai -m display --focus prev
shift + alt - e : yabai -m window --display next; yabai -m display --focus next
ctrl + alt - w : yabai -m display --focus prev || yabai -m display --focus last
ctrl + shift + alt - w : yabai -m window --display prev; yabai -m display --focus prev
ctrl + shift + alt - e : yabai -m window --display next; yabai -m display --focus next
